
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
    color: #263445;
    background-color: #f4f7fb;
}

header {
    padding: 55px 20px;
    text-align: center;
    color: white;
    background: #183153;
}

header h1 {
    max-width: 900px;
    margin: 0 auto;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.3;
}

main {
    max-width: 1000px;
    margin: 35px auto;
    padding: 0 22px;
}

section {
    margin-bottom: 25px;
    padding: 30px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(20, 40, 70, 0.05);
}

section h2 {
    margin-top: 0;
    margin-bottom: 15px;
    color: #214f87;
    font-size: 25px;
}

section p {
    margin-bottom: 0;
}

section img {
    display: block;
    width: 100%;
    max-height: 330px;
    margin: 15px 0 20px;
    object-fit: cover;
    border-radius: 7px;
}

.hero {
    padding: 0;
    overflow: hidden;
}

.hero img {
    width: 100%;
    height: 360px;
    max-height: none;
    margin: 0;
    object-fit: cover;
}

ul {
    padding-left: 25px;
}

li {
    margin-bottom: 10px;
}

footer {
    padding: 25px 20px;
    text-align: center;
    color: #dce6f3;
    background: #183153;
    font-size: 14px;
}

footer p {
    margin: 0;
}

@media (max-width: 600px) {
    header {
        padding: 38px 20px;
    }

    main {
        margin: 20px auto;
        padding: 0 13px;
    }

    section {
        padding: 22px;
    }

    section h2 {
        font-size: 22px;
    }

    .hero img {
        height: 230px;
    }
}
